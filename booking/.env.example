# Copy to .env.local for local work, and set the same two in Vercel.
#
# Both are read at BUILD time, not at run time, because NEXT_PUBLIC_
# values are inlined into the bundle. A deployment without them fails
# while building /start rather than starting up and misbehaving.
#
# The publishable key is safe in the browser by design: every table is
# behind row level security, so it can only reach what a signed-in user
# is allowed to reach. The service role key is not used anywhere.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional. The domain yards live under, used to work out which yard a
# request is for and to build their addresses. Defaults to
# thelazyhorseman.com, which is right in production, so it only needs
# setting somewhere serving yards under a different domain.
# NEXT_PUBLIC_ROOT_DOMAIN=thelazyhorseman.com
