# Copy to .env.local for local work, and set the same values in Vercel.
#
# The two below are read at BUILD time, not at run time, because
# NEXT_PUBLIC_ values are inlined into the bundle. A deployment without
# them fails while building /start rather than starting up and
# misbehaving. The server-only ones further down are read per request,
# so changing one takes a redeploy but not a rebuild.
#
# The publishable key is safe in the browser by design: every table is
# behind row level security, so it can only reach what a signed-in user
# is allowed to reach. The service role key is not used anywhere.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional. The domain yards live under, used to work out which yard a
# request is for and to build their addresses. Defaults to
# thelazyhorseman.com, which is right in production, so it only needs
# setting somewhere serving yards under a different domain.
# NEXT_PUBLIC_ROOT_DOMAIN=thelazyhorseman.com

# Sending email, through Resend. Server only: this must never be
# NEXT_PUBLIC_, which would inline it into the browser bundle.
#
# Without it the app still works. Invites are made and slots still
# cancel; nothing is sent, and the screen says so and shows the yard
# the link to pass on by hand.
RESEND_API_KEY=

# Optional. Who the email comes from. The address has to sit on a
# domain verified in Resend or every send is refused. Defaults to
# The Lazy Horseman <bookings@thelazyhorseman.com>.
# EMAIL_FROM=The Lazy Horseman <bookings@thelazyhorseman.com>

# Registering a yard's address with Vercel. Server only.
#
# DNS already sends every subdomain to the booking project, but Vercel
# serves nothing for a host it has no domain object for and issues no
# certificate, so a yard is not reachable until the app has registered
# it. Without these the yard is still made and the account page offers
# to set the address up later.
#
# The token needs the Domains scope on the team that owns the booking
# project. VERCEL_PROJECT_ID is on the project's Settings page.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
# Only on a team account, not a personal one.
# VERCEL_TEAM_ID=
