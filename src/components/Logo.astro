---
interface Props {
  class?: string;
  as?: 'a' | 'p';
  href?: string;
}

const { class: className = '', as = 'a', href = '/' }: Props = Astro.props;
const Tag = as;
---

<Tag class={className} {...(as === 'a' ? { href, 'aria-label': 'The Lazy Horseman, home' } : {})}>
